# Copy this to keystore.properties (which is gitignored) to build a signed release APK.
#
# Create the keystore first, from the project folder:
#
#   keytool -genkeypair -v -keystore release.jks -alias unscathed \
#       -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.jks and its passwords safe and backed up. Android ties app identity to the
# signing key: lose it and you cannot ship an update that existing installs will accept,
# and anyone who gets hold of it can publish updates that look genuinely like yours.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=unscathed
keyPassword=CHANGE_ME
