# Build output
build/
.gradle/
.cxx/
*.apk
*.aab
*.ap_
*.dex
local.properties

# Signing material - these must never be published. Anyone with your keystore and
# password can publish updates that Android will accept as genuinely yours.
*.jks
*.keystore
*.p12
keystore.properties

# IDE
.idea/
*.iml
.DS_Store
captures/

# Scratch
*.log

# Base64 export of the signing keystore (made for the CI secret). It is the private key in
# text form, so it must never be committed.
*.b64.txt
